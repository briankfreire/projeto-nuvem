# Copie para ".env" e TROQUE AS SENHAS. O ".env" nunca vai para o Git.
# Use senhas só com letras e números (sem $, #, aspas ou espaços) e sem comentário na mesma linha.

# PostgreSQL: administrador (só para criar o banco) e usuário da aplicação (privilégio mínimo)
POSTGRES_DB=wattreport
POSTGRES_USER=wattreport_admin
POSTGRES_PASSWORD=troqueAdmin123
APP_DB_USER=wattreport_app
APP_DB_PASSWORD=troqueApp123

# RabbitMQ: usuário e vhost próprios (nada de guest/guest)
RABBITMQ_USER=wattreport
RABBITMQ_PASSWORD=troqueRabbit123
RABBITMQ_VHOST=wattreport

# Worker: tempo de CPU por relatório (ms) e taxa de falha técnica simulada (0 a 1)
TRABALHO_CPU_MS=1500
TAXA_FALHA_SIMULADA=0

# Porta do computador/VM onde o NGINX fica acessível
PORTA_APP=8080
